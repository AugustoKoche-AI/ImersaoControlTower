{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs governados (mv_projetos)",
      "queryLines": [
        "-- Os KPIs vêm da metric view: a fórmula do SPI e do CPI mora num lugar só.\n",
        "SELECT MEASURE(carteira) AS carteira, MEASURE(spi) AS spi, MEASURE(cpi) AS cpi,\n",
        "       MEASURE(estouro_previsto) AS estouro_previsto, MEASURE(margem_projetada) AS margem_projetada,\n",
        "       MEASURE(projetos_em_risco) AS projetos_em_risco, MEASURE(projetos_criticos) AS projetos_criticos,\n",
        "       MEASURE(projetos_melancia) AS projetos_melancia\n",
        "FROM mv_projetos\n"
      ]
    },
    {
      "name": "ds_projetos",
      "displayName": "Projetos em andamento hoje",
      "queryLines": [
        "SELECT projeto_id, projeto, cliente, segmento, ferramenta, situacao, spi, cpi, estouro_previsto, margem_projetada,\n",
        "       atraso_projetado_dias, termino_projetado, farol_do_gerente, farol_calculado,\n",
        "       CASE WHEN melancia THEN 'sim' ELSE '' END AS melancia, valor_contrato\n",
        "FROM projeto_situacao_atual\n",
        "WHERE status = 'em_andamento'\n"
      ]
    },
    {
      "name": "ds_evolucao",
      "displayName": "Evolução semanal da carteira",
      "queryLines": [
        "SELECT semana, MEASURE(spi) AS spi, MEASURE(cpi) AS cpi, MEASURE(horas_ociosas) AS horas_ociosas\n",
        "FROM mv_evolucao\n",
        "WHERE semana >= DATE'2025-03-07'\n",
        "GROUP BY semana\n",
        "ORDER BY semana\n"
      ]
    },
    {
      "name": "ds_pessoas",
      "displayName": "Pessoas nas últimas 12 semanas",
      "queryLines": [
        "SELECT colaborador_id, nome, papel, senioridade, projeto_id, projeto,\n",
        "       SUM(horas_apontadas) / SUM(horas_disponiveis) AS utilizacao,\n",
        "       SUM(horas_ociosas) AS horas_ociosas, SUM(custo_ocioso) AS custo_ocioso, MIN(spi_do_projeto) AS spi_do_projeto\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_pessoas_top",
      "displayName": "Pessoas mais paradas (top 15)",
      "queryLines": [
        "SELECT concat(nome, ' · ', papel, ' · ', projeto_id) AS pessoa, SUM(custo_ocioso) AS custo_ocioso\n",
        "FROM utilizacao_pessoa_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY 1\n",
        "ORDER BY 2 DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "ds_bloqueios",
      "displayName": "Causas de bloqueio nos últimos 90 dias",
      "queryLines": [
        "SELECT s.projeto_id, p.projeto, s.causa_bloqueio, COUNT(*) AS semanas, SUM(coalesce(s.dias_impacto, 0)) AS dias_impacto\n",
        "FROM status_estruturado s JOIN projeto_situacao_atual p USING (projeto_id)\n",
        "WHERE s.data_status >= DATE'2026-07-18' AND s.causa_bloqueio NOT IN ('sem_bloqueio', 'nao_reportado')\n",
        "  AND p.status = 'em_andamento'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_capacidade",
      "displayName": "Capacidade contratada hoje",
      "queryLines": [
        "SELECT projeto, fornecedor, tipo, unidade, saldo, consumo_previsto_dia, cobertura_dias, data_prevista_fim_saldo,\n",
        "       CASE WHEN ruptura_prevista THEN 1 ELSE 0 END AS ruptura\n",
        "FROM cobertura_capacidade\n"
      ]
    },
    {
      "name": "ds_fornecedores",
      "displayName": "Desempenho de fornecedor",
      "queryLines": [
        "SELECT fornecedor, entregas, grafias_no_cadastro, prazo_prometido_medio, prazo_real_medio,\n",
        "       fator_atraso, pct_no_prazo, entregas_em_atraso\n",
        "FROM desempenho_fornecedor\n",
        "ORDER BY fator_atraso DESC\n"
      ]
    }
  ],
