{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs governados (mv_obras)",
      "queryLines": [
        "-- Os KPIs vêm da metric view: a fórmula do SPI e do CPI mora num lugar só.\n",
        "SELECT MEASURE(carteira) AS carteira, MEASURE(spi) AS spi, MEASURE(cpi) AS cpi,\n",
        "       MEASURE(estouro_previsto) AS estouro_previsto, MEASURE(margem_projetada) AS margem_projetada,\n",
        "       MEASURE(obras_em_risco) AS obras_em_risco, MEASURE(obras_criticas) AS obras_criticas\n",
        "FROM mv_obras\n"
      ]
    },
    {
      "name": "ds_obras",
      "displayName": "Obras em andamento hoje",
      "queryLines": [
        "SELECT projeto_id, obra, cliente, setor, uf, situacao, spi, cpi, estouro_previsto, margem_projetada,\n",
        "       atraso_projetado_dias, termino_projetado, rupturas_previstas, valor_contrato\n",
        "FROM obra_situacao_atual\n",
        "WHERE status = 'em_andamento'\n"
      ]
    },
    {
      "name": "ds_evolucao",
      "displayName": "Evolução semanal da carteira",
      "queryLines": [
        "SELECT semana, MEASURE(spi) AS spi, MEASURE(cpi) AS cpi, MEASURE(horas_ociosas) AS horas_ociosas\n",
        "FROM mv_evolucao\n",
        "WHERE semana >= DATE'2025-03-07'\n",
        "GROUP BY semana\n",
        "ORDER BY semana\n"
      ]
    },
    {
      "name": "ds_equipamentos",
      "displayName": "Frota nas últimas 12 semanas",
      "queryLines": [
        "SELECT equipamento_id, tipo, modelo, obra, uf,\n",
        "       SUM(horas_operadas) / SUM(horas_disponiveis) AS utilizacao,\n",
        "       SUM(horas_paradas) AS horas_paradas, SUM(custo_ocioso) AS custo_ocioso\n",
        "FROM utilizacao_equipamento_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_frota_top",
      "displayName": "Frota mais parada (top 15)",
      "queryLines": [
        "SELECT concat(equipamento_id, ' · ', modelo, ' · ', projeto_id) AS equipamento, SUM(custo_ocioso) AS custo_ocioso\n",
        "FROM utilizacao_equipamento_semana\n",
        "WHERE semana > DATE'2026-07-24'\n",
        "GROUP BY 1\n",
        "ORDER BY 2 DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "ds_equipe",
      "displayName": "Equipes nas últimas 8 semanas",
      "queryLines": [
        "SELECT obra, uf, SUM(horas_ociosas) AS horas_ociosas, SUM(horas_apontadas) / SUM(horas_disponiveis) AS utilizacao,\n",
        "       MIN(spi_da_obra) AS spi_da_obra\n",
        "FROM utilizacao_equipe_semana\n",
        "WHERE semana > DATE'2026-08-21'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_estoque",
      "displayName": "Cobertura de estoque hoje",
      "queryLines": [
        "SELECT obra, uf, material, disciplina, saldo, cobertura_dias, dias_ate_reposicao,\n",
        "       proxima_entrega_prometida, fornecedor_proxima_entrega,\n",
        "       CASE WHEN ruptura_prevista THEN 1 ELSE 0 END AS ruptura\n",
        "FROM cobertura_estoque\n"
      ]
    },
    {
      "name": "ds_fornecedores",
      "displayName": "Desempenho de fornecedor",
      "queryLines": [
        "SELECT fornecedor, pedidos, grafias_no_erp, lead_time_prometido_medio, lead_time_real_medio,\n",
        "       fator_atraso, pct_no_prazo, pedidos_em_atraso\n",
        "FROM desempenho_fornecedor\n",
        "ORDER BY fator_atraso DESC\n"
      ]
    }
  ],
